{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    18,
    22
  ],
  "preview": "mods/quantum/preview.png",
  "theme": "quantum",
  "colors": {
    "canvas": "#00000000",
    "chrome": "#0a0e2ce6",
    "surface": "#0c1232dd",
    "background": "#0a1030",
    "border": "#4a52b077",
    "input": "#8b6cffaa",
    "hover": "#ffffff12",
    "selected": "#2a3290cc",
    "raised": "#151a4ee8",
    "popover": "#0c1034f6",
    "muted": "#a3a9e0",
    "dim": "#6d73b3"
  },
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0,
  "background": {
    "image": "mods/quantum/nebula-deep.jpg",
    "fit": "cover"
  },
  "padding": [
    6,
    10
  ],
  "gap": 0,
  "children": [
    {
      "id": "top",
      "type": "block",
      "size": {
        "px": 56
      },
      "window_drag": true,
      "content": {
        "mod": "quantum",
        "props": {
          "role": "top"
        }
      }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 10,
      "resizable": true,
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 276
          },
          "min": 230,
          "max": 480,
          "content": {
            "mod": "quantum",
            "props": {
              "role": "sidebar"
            }
          }
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "size": {
            "weight": 1
          },
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 40
              },
              "window_drag": true,
              "content": {
                "mod": "quantum",
                "props": {
                  "role": "tabs"
                }
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "padding": 0,
              "gap": 10,
              "resizable": true,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 10,
                      "radius": 0,
                      "background": "#0b1236b8",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "#4a58b8aa"
                      },
                      "focus": {
                        "width": 1,
                        "color": "#4fd8ffaa"
                      },
                      "header": {
                        "content": {
                          "mod": "quantum",
                          "props": {
                            "role": "pane"
                          }
                        },
                        "height": 38,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ],
                  "background": "#0b1236b8",
                  "border": {
                    "width": 1,
                    "color": "#4a58b8aa"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "session",
          "type": "column",
          "size": {
            "px": 330
          },
          "min": 260,
          "max": 520,
          "resizable": false,
          "children": [
            {
              "id": "side-tabs",
              "type": "block",
              "size": {
                "px": 40
              },
              "content": {
                "mod": "quantum",
                "props": {
                  "role": "sidetabs"
                }
              }
            },
            {
              "id": "side-body",
              "type": "stack",
              "active": "side-session",
              "children": [
                {
                  "id": "side-session",
                  "type": "block",
                  "content": {
                    "mod": "quantum",
                    "props": {
                      "role": "session"
                    }
                  }
                },
                {
                  "id": "side-tasks",
                  "type": "block",
                  "content": {
                    "mod": "task-board"
                  },
                  "background": "#0b1236b8",
                  "border": {
                    "width": 1,
                    "color": "#4a58b8aa"
                  }
                }
              ],
              "padding": null
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 46
      },
      "content": {
        "mod": "quantum",
        "props": {
          "role": "status"
        }
      }
    }
  ]
}
