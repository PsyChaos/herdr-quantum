{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    18,
    22
  ],
  "preview": "mods/quantum/preview.png",
  "theme": "quantum",
  "colors": {
    "canvas": "#00000000",
    "chrome": "#0c0f34b8",
    "surface": "#11154299",
    "background": "#0e1236",
    "border": "#5d63d855",
    "input": "#8b6cffaa",
    "hover": "#ffffff12",
    "selected": "#3a3fb0aa",
    "raised": "#1a1f5acc",
    "popover": "#10133ff2",
    "muted": "#a3a9e0",
    "dim": "#6d73b3"
  },
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0,
  "background": {
    "image": "mods/quantum/space.jpg",
    "fit": "cover"
  },
  "padding": [
    4,
    6
  ],
  "gap": 0,
  "children": [
    {
      "id": "top",
      "type": "block",
      "size": {
        "px": 56
      },
      "window_drag": true,
      "content": {
        "mod": "quantum",
        "props": {
          "role": "top"
        }
      }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 0,
      "resizable": true,
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 276
          },
          "min": 230,
          "max": 480,
          "content": {
            "mod": "quantum",
            "props": {
              "role": "sidebar"
            }
          }
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "size": {
            "weight": 1
          },
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 40
              },
              "window_drag": true,
              "content": {
                "mod": "quantum",
                "props": {
                  "role": "tabs"
                }
              }
            },
            {
              "id": "card",
              "type": "column",
              "padding": 0,
              "resizable": false,
              "children": [
                {
                  "id": "card-mid",
                  "type": "row",
                  "resizable": false,
                  "children": [
                    {
                      "id": "edge-left",
                      "type": "block",
                      "size": {
                        "px": 12
                      },
                      "resizable": false,
                      "content": {
                        "mod": "quantum",
                        "props": {
                          "role": "edge",
                          "side": "left"
                        }
                      }
                    },
                    {
                      "id": "work-body",
                      "type": "row",
                      "padding": 6,
                      "gap": 8,
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 12,
                              "background": "#00000000",
                              "lone": true,
                              "border": {
                                "width": 1,
                                "color": "#8b6cff00"
                              },
                              "focus": {
                                "width": 1,
                                "color": "#8b6cff00"
                              },
                              "header": {
                                "content": {
                                  "mod": "quantum",
                                  "props": {
                                    "role": "pane"
                                  }
                                },
                                "height": 38,
                                "position": "top",
                                "reveal": "always"
                              }
                            }
                          }
                        },
                        {
                          "id": "panel",
                          "type": "column",
                          "hidden": true,
                          "size": {
                            "px": 368
                          },
                          "min": 280,
                          "max": 900,
                          "children": [
                            {
                              "id": "panel-body",
                              "type": "stack",
                              "active": "files",
                              "children": [
                                {
                                  "id": "files",
                                  "type": "block",
                                  "content": {
                                    "mod": "files"
                                  }
                                },
                                {
                                  "id": "changes",
                                  "type": "block",
                                  "content": {
                                    "mod": "changes"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "background": "#0e1236e0",
                      "radius": 18,
                      "border": {
                        "width": 1,
                        "color": "#dcd2ffee"
                      }
                    },
                    {
                      "id": "edge-right",
                      "type": "block",
                      "size": {
                        "px": 12
                      },
                      "resizable": false,
                      "content": {
                        "mod": "quantum",
                        "props": {
                          "role": "edge",
                          "side": "right"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "edge-bottom",
                  "type": "block",
                  "size": {
                    "px": 12
                  },
                  "resizable": false,
                  "content": {
                    "mod": "quantum",
                    "props": {
                      "role": "edge",
                      "side": "bottom"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "session",
          "type": "column",
          "size": {
            "px": 330
          },
          "min": 260,
          "max": 520,
          "resizable": false,
          "children": [
            {
              "id": "side-tabs",
              "type": "block",
              "size": {
                "px": 60
              },
              "content": {
                "mod": "quantum",
                "props": {
                  "role": "sidetabs"
                }
              }
            },
            {
              "id": "side-body",
              "type": "stack",
              "active": "side-session",
              "children": [
                {
                  "id": "side-session",
                  "type": "block",
                  "content": {
                    "mod": "quantum",
                    "props": {
                      "role": "session"
                    }
                  }
                },
                {
                  "id": "side-tasks",
                  "type": "block",
                  "padding": [
                    6,
                    10
                  ],
                  "content": {
                    "mod": "task-board"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 44
      },
      "content": {
        "mod": "quantum",
        "props": {
          "role": "status"
        }
      }
    }
  ]
}